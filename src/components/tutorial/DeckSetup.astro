---
interface Props {
  mode?: "overview" | "preview" | "transition";
  showBeats?: boolean;
}

const { mode = "overview", showBeats = false } = Astro.props;
---

<div
  class:list={[
    "deck-setup",
    `deck-setup--${mode}`,
    { "deck-setup--animating": mode === "transition" },
  ]}
  aria-label="Simplified two-deck DJ setup, not an exact software screenshot"
>
  <div class="deck-card deck-card--a deck-card--audible">
    <div class="deck-heading">
      <span>DECK A</span>
      <span class="track-badge">
        <span class="deck-track--before">PLAYING</span>
        {
          mode === "transition" && (
            <span class="deck-track--after">UP NEXT</span>
          )
        }
      </span>
    </div>
    <div class="record"><span>A</span></div>
    <div class="deck-track">
      <span class="deck-track--before">NOW PLAYING</span>
      {
        mode === "transition" && (
          <span class="deck-track--after">FIND NEW TRACK</span>
        )
      }
    </div>
    <div class="waveform" aria-hidden="true"></div>
    <div class="deck-buttons"><span>▶ / Ⅱ</span></div>
  </div>
  <div class="mixer-card">
    <div class="mixer-label">MIXER</div>
    <div class="channel-levels" aria-hidden="true">
      <span></span><span></span>
    </div>
    <div class="mixer-small">Track volumes</div>
    <div class="crossfader"><span></span></div>
    <div class="crossfader-labels">
      <span>A</span><span>Crossfader</span>
      <span class="crossfader-b"
        >B
        {
          mode === "preview" && (
            <span class="headphone-cue" aria-label="Deck B in headphones">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M3 14v-3a9 9 0 0 1 18 0v3" />
                <path d="M3 14h4v7H5a2 2 0 0 1-2-2v-5Zm18 0h-4v7h2a2 2 0 0 0 2-2v-5Z" />
              </svg>
            </span>
          )
        }
      </span>
    </div>
  </div>
  <div class="deck-card deck-card--b">
    <div class="deck-heading">
      <span>DECK B</span>
      <span class="track-badge">
        <span class="deck-track--before">UP NEXT</span>
        {
          mode === "transition" && (
            <span class="deck-track--after">PLAYING</span>
          )
        }
      </span>
    </div>
    <div class="record"><span>B</span></div>
    <div class="deck-track">
      <span class="deck-track--before">UP NEXT</span>
      {
        mode === "transition" && (
          <span class="deck-track--after">NOW PLAYING</span>
        )
      }
    </div>
    <div class="waveform" aria-hidden="true"></div>
    <div class="deck-buttons"><span>▶ / Ⅱ</span></div>
  </div>
  {
    showBeats && (
      <>
        <div
          class="deck-beats deck-beats--a"
          role="img"
          aria-label="Deck A: beats 1, 2, 3, 4 in time with Deck B"
        >
          {[1, 2, 3, 4].map((beat) => (
            <span aria-hidden="true">{beat}</span>
          ))}
        </div>
        <div
          class="deck-beats deck-beats--b"
          role="img"
          aria-label="Deck B: beats 1, 2, 3, 4 in time with Deck A"
        >
          {[1, 2, 3, 4].map((beat) => (
            <span aria-hidden="true">{beat}</span>
          ))}
        </div>
      </>
    )
  }
  {
    mode === "preview" && (
      <div class="headphone-route">
        HEADPHONES: Listen to B privately, find the TEMPO and the 1 using CUE
      </div>
    )
  }
</div>
