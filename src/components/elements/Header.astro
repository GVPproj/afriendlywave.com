---
import Logo from "../../assets/logo.svg";
import GroundwavesLogo from "../../assets/groundwaves-logo.svg";
---

<header class="bg-navy/80 sticky top-0 z-50 w-full py-4 backdrop-blur-md">
  <div
    class="mx-auto flex max-w-screen-2xl items-center justify-between gap-3 px-6"
  >
    <Logo class="text-link w-8" />

    <a href="https://groundwaves.live">
      <GroundwavesLogo class="text-link hover:text-link-hover h-6" />
    </a>
  </div>
</header>
