---
import Logo from "../../assets/logo.svg";
import Instagram from "../../assets/instagram.svg";
import Mixcloud from "../../assets/mixcloud.svg";
---

<header class="bg-navy/80 sticky top-0 z-50 w-full py-4 backdrop-blur-md">
  <div
    class="mx-auto flex max-w-screen-2xl items-center justify-between gap-3 px-6"
  >
    <a href="/">
      <Logo
        width={32}
        height={31}
        class="text-link hover:text-link-hover w-8 transition-colors"
      />
    </a>

    <div class="flex items-baseline gap-4">
      <a
        href="https://instagram.com/a.friendly.wave"
        target="_blank"
        rel="noopener noreferrer"
        class="mr-1 -translate-y-0.5 self-center"
      >
        <Instagram
          width={20}
          height={20}
          class="text-link hover:text-link-hover h-5 w-5 transition-colors"
        />
      </a>
      <a
        href="https://mixcloud.com/afriendlywave"
        target="_blank"
        rel="noopener noreferrer"
        class="-translate-y-0.5 self-center"
      >
        <Mixcloud
          width={20}
          height={15}
          class="text-link hover:text-link-hover h-5 w-5 transition-colors"
        />
      </a>
      <a
        href="/about"
        class="text-link hover:text-link-hover tracking-wide uppercase">About</a
      >

      <a
        href="https://checkout.square.site/merchant/MLT5XQ4FD8136/checkout/UNEZZDEI2IPM6VWLX4KGZXUL"
        class="text-link hover:text-link-hover tracking-wide uppercase"
        target="_blank"
        rel="noopener noreferrer">Donate</a
      >
      <!-- <a -->
      <!--   href="https://groundwaves.live" -->
      <!--   target="_blank" -->
      <!--   rel="noopener noreferrer" -->
      <!--   class="text-link hover:text-link-hover leading-none font-bold" -->
      <!--   style="font-family: 'Fraunces', serif;" -->
      <!-- > -->
      <!--   groundwaves -->
      <!-- </a> -->
    </div>
  </div>
</header>
