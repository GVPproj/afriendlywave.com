---
import Logo from "../../assets/logo.svg";
import Instagram from "../../assets/instagram.svg";
import Mixcloud from "../../assets/mixcloud.svg";
---

<header class="bg-surface/80 sticky top-0 z-50 w-full py-4 backdrop-blur-md">
  <div class="site-container gap-card flex items-center justify-between">
    <a
      href="/"
      class="inline-flex min-h-11 items-center"
      aria-label="A Friendly Wave home"
    >
      <Logo
        width={32}
        height={31}
        class="text-accent hover:text-highlight w-8 transition-colors"
      />
    </a>

    <nav
      aria-label="Main"
      class="flex items-center gap-2 leading-none sm:gap-panel"
    >
      <a
        href="https://instagram.com/a.friendly.wave"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 min-w-8 items-center justify-center"
        aria-label="Instagram (opens in a new tab)"
      >
        <Instagram
          width={20}
          height={20}
          class="text-accent hover:text-highlight h-5 w-5 transition-colors"
        />
      </a>
      <a
        href="https://mixcloud.com/afriendlywave"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 min-w-8 items-center justify-center"
        aria-label="Mixcloud (opens in a new tab)"
      >
        <Mixcloud
          width={20}
          height={15}
          class="text-accent hover:text-highlight h-5 w-5 transition-colors"
        />
      </a>
      <a
        href="/about"
        class="text-accent hover:text-highlight inline-flex min-h-11 items-center tracking-wide uppercase"
        >About</a
      >

      <a
        href="https://checkout.square.site/merchant/MLT5XQ4FD8136/checkout/UNEZZDEI2IPM6VWLX4KGZXUL"
        class="text-accent hover:text-highlight inline-flex min-h-11 items-center tracking-wide uppercase"
        target="_blank"
        rel="noopener noreferrer">Donate</a
      >
      <!-- <a -->
      <!--   href="https://groundwaves.live" -->
      <!--   target="_blank" -->
      <!--   rel="noopener noreferrer" -->
      <!--   class="text-accent hover:text-highlight leading-none font-bold" -->
      <!--   style="font-family: 'Fraunces', serif;" -->
      <!-- > -->
      <!--   groundwaves -->
      <!-- </a> -->
    </nav>
  </div>
</header>
