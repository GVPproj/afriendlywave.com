---
import Logo from "../../assets/logo.svg";
import GroundwavesLogo from "../../assets/groundwaves-logo.svg";
import Instagram from "../../assets/instagram.svg";
import Mixcloud from "../../assets/mixcloud.svg";
---

<header class="bg-navy/80 sticky top-0 z-50 w-full py-4 backdrop-blur-md">
  <div
    class="mx-auto flex max-w-screen-2xl items-center justify-between gap-3 px-6"
  >
    <a href="/">
      <Logo class="text-link w-8" />
    </a>

    <div class="flex items-center gap-4">
      <a
        href="/about"
        class="text-link hover:text-link-hover mt-1 tracking-wide uppercase"
        >About</a
      >
      <a
        href="https://instagram.com/a.friendly.wave"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Instagram class="text-link hover:text-link-hover h-6 w-6" />
      </a>
      <a
        href="https://mixcloud.com/afriendlywave"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Mixcloud class="text-link hover:text-link-hover h-6 w-6" />
      </a>
      <a
        href="https://groundwaves.live"
        target="_blank"
        rel="noopener noreferrer"
      >
        <GroundwavesLogo class="text-link hover:text-link-hover h-6" />
      </a>
    </div>
  </div>
</header>
