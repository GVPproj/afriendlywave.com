---
import ShowCard from "./ShowCard.astro";

interface Props {
  username?: string;
  limit?: number;
  offset?: number;
}

const { username = "afriendlywave", limit = 12, offset = 0 } = Astro.props;

const response = await fetch(
  `https://api.mixcloud.com/${username}/cloudcasts/?limit=${limit + offset}`,
);
const data = await response.json();
const shows = (data.data || []).slice(offset);
---

<div
  class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 mx-auto"
>
  {
    shows.map((show: any) => (
      <ShowCard
        name={show.name}
        imageUrl={show.pictures.extra_large}
        feedKey={show.key}
      />
    ))
  }
</div>

<script>
  document.querySelectorAll(".show-card").forEach((card) => {
    card.addEventListener("click", () => {
      const feed = card.getAttribute("data-feed");
      if (feed) {
        window.dispatchEvent(
          new CustomEvent("mixcloud:play", { detail: { feed } }),
        );
      }
    });
  });
</script>
