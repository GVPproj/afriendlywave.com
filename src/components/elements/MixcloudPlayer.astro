---
interface Props {
  feed?: string;
  hideArtwork?: boolean;
  mini?: boolean;
  light?: boolean;
}

const {
  feed = '/afriendlywave/',
  hideArtwork = false,
  mini = true,
  light = false
} = Astro.props;

const params = new URLSearchParams({
  feed: feed,
  hide_cover: '1',
  ...(hideArtwork && { hide_artwork: '1' }),
  ...(mini && { mini: '1' }),
  ...(light && { light: '1' }),
});

const iframeSrc = `https://www.mixcloud.com/widget/iframe/?${params.toString()}`;
---

<template id="mixcloud-data" data-src={iframeSrc}></template>

<script is:inline>
  (function () {
    if (document.getElementById('mixcloud-player-container')) return;

    var src = document.getElementById('mixcloud-data')?.getAttribute('data-src');
    if (!src) return;

    var container = document.createElement('div');
    container.id = 'mixcloud-player-container';
    container.style.cssText =
      'position:fixed;bottom:0;left:0;right:0;width:100%;height:60px;z-index:50;';

    var iframe = document.createElement('iframe');
    iframe.id = 'mixcloud-player';
    iframe.src = src;
    iframe.allow = 'autoplay';
    iframe.loading = 'lazy';
    iframe.style.cssText = 'width:100%;height:100%;border:none;';

    container.appendChild(iframe);
    document.documentElement.appendChild(container);

    window.addEventListener('mixcloud:play', function (e) {
      var detail = e.detail;
      if (iframe && detail && detail.feed) {
        var params = new URLSearchParams({
          feed: detail.feed,
          hide_cover: '1',
          mini: '1',
          autoplay: '1',
        });
        iframe.src =
          'https://www.mixcloud.com/widget/iframe/?' + params.toString();
      }
    });
  })();
</script>
