---
import partyMp4 from "../assets/afw_web_assets/partyvids/web/afw-party-720.mp4";
import partyWebm from "../assets/afw_web_assets/partyvids/web/afw-party-1080.webm";
import partyPoster from "../assets/afw_web_assets/partyvids/web/afw-party-poster.jpg";
---

<!-- Mobile design: B from branch prototype/party-video-mobile. -->
<section
  class="party-section md:border-ink/20 md:rounded-card md:p-card md:border"
>
  <div class="relative overflow-hidden">
    <video
      class="party-video w-full object-cover"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={partyPoster.src}
      data-party-video
    >
      <source src={partyWebm} type="video/webm" />
      <source src={partyMp4} type="video/mp4" />
    </video>
    <button
      class="party-playback md:hidden"
      type="button"
      aria-label="Pause party video"
      data-party-playback
      data-paused="false"
    >
      <svg
        class="pause-icon"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M6 4h4v16H6zm8 0h4v16h-4z"></path>
      </svg>
      <svg
        class="play-icon"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M8 4v16l12-8z"></path>
      </svg>
    </button>
    <div
      class="md:absolute md:inset-0 md:flex md:items-center md:justify-start"
    >
      <div
        class="party-story md:bg-surface/80 md:max-w-2xl md:backdrop-blur-lg"
      >
        <p class="text-ink md:text-lg">
          <span class="text-highlight">A Friendly Wave</span> is a unique cultural
          experiment that celebrates Salt Spring Island's creative spirit while introducing
          new perspectives on how we experience music together.
        </p>{" "}
        <p class="text-ink md:text-lg">
          Whether you're an audiophile, a casual listener, or simply curious
          about mindful cultural experiences, the Salt Spring Listening Space
          offers something transformative.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .party-section {
    margin-inline: calc(-1 * var(--spacing-gutter));
  }
  .party-video {
    aspect-ratio: 3 / 4;
    max-height: 72svh;
  }
  .party-story {
    margin-inline: var(--spacing-gutter);
    padding-block: var(--spacing-panel);
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-ink) calc(64 / 255 * 100%), transparent);
    font-size: 1.125rem;
    line-height: var(--leading-copy);
  }
  .party-story p {
    margin-bottom: var(--spacing-panel);
  }
  .party-playback {
    position: absolute;
    z-index: 10;
    top: var(--spacing-card);
    right: var(--spacing-card);
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid
      color-mix(in srgb, var(--color-ink) calc(96 / 255 * 100%), transparent);
    border-radius: 99px;
    background: color-mix(
      in srgb,
      var(--color-surface) calc(217 / 255 * 100%),
      transparent
    );
    color: var(--color-ink);
    cursor: pointer;
  }
  .party-playback .play-icon,
  .party-playback[data-paused="true"] .pause-icon {
    display: none;
  }
  .party-playback[data-paused="true"] .play-icon {
    display: block;
  }
  .party-playback:focus-visible {
    outline: 2px solid var(--color-highlight);
    outline-offset: 3px;
  }
  @media (min-width: 768px) {
    .party-section {
      margin-inline: 0;
    }
    .party-video {
      height: 60vh;
      max-height: none;
      aspect-ratio: auto;
    }
    .party-story {
      margin: var(--spacing-gutter);
      padding: var(--spacing-panel);
      border-bottom: 0;
      font-size: inherit;
      line-height: inherit;
    }
    .party-story p {
      display: inline;
      margin: 0;
    }
  }
</style>

<script>
  function setupPartyVideo() {
    const video =
      document.querySelector<HTMLVideoElement>("[data-party-video]");
    if (!video) return;
    const button = document.querySelector<HTMLButtonElement>(
      "[data-party-playback]",
    );
    if (button) {
      const updateLabel = () => {
        const action = video.paused ? "Play" : "Pause";
        button.dataset.paused = String(video.paused);
        button.setAttribute("aria-label", `${action} party video`);
      };
      button.onclick = () => {
        if (video.paused) video.play().catch(() => {});
        else video.pause();
      };
      video.onplay = updateLabel;
      video.onpause = updateLabel;
      updateLabel();
    }
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      video.removeAttribute("autoplay");
      video.pause();
    } else if (video.paused) {
      // autoplay doesn't re-fire when ClientRouter swaps the page back in
      video.play().catch(() => {});
    }
  }
  setupPartyVideo();
  document.addEventListener("astro:page-load", setupPartyVideo);
</script>
