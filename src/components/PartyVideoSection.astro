---
import partyMp4 from "../assets/afw_web_assets/partyvids/web/afw-party-720.mp4";
import partyWebm from "../assets/afw_web_assets/partyvids/web/afw-party-1080.webm";
import partyPoster from "../assets/afw_web_assets/partyvids/web/afw-party-poster.jpg";
---

<!-- Selected B: prototype/block-design-variants; see docs/identity.md. -->
<section class="party-section">
  <div class="relative">
    <video
      class="party-video w-full object-cover"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={partyPoster.src}
      data-party-video
    >
      <source src={partyWebm} type="video/webm" />
      <source src={partyMp4} type="video/mp4" />
    </video>
    <button
      class="party-playback md:hidden"
      type="button"
      aria-label="Pause party video"
      data-party-playback
      data-paused="false"
    >
      <svg
        class="pause-icon"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M6 4h4v16H6zm8 0h4v16h-4z"></path>
      </svg>
      <svg
        class="play-icon"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M8 4v16l12-8z"></path>
      </svg>
    </button>
    <div class="party-story-panel">
      <div class="party-story">
        <p>
          <span class="party-story-name">A Friendly Wave</span> is a unique cultural
          experiment that celebrates Salt Spring Island's creative spirit while introducing
          new perspectives on how we experience music together.
        </p>{" "}
        <p>
          Whether you're an audiophile, a casual listener, or simply curious
          about mindful cultural experiences, the Salt Spring Listening Space
          offers something transformative.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .party-section {
    padding-bottom: 48px;
  }
  .party-video {
    height: 400px;
    max-height: 72svh;
  }
  .party-story-panel {
    position: relative;
    width: 92%;
    margin: -50px 16px 0 0;
    background: var(--color-accent);
    color: var(--color-on-accent);
    box-shadow: 16px 16px 0 var(--color-secondary);
  }
  .party-story {
    padding: 24px;
    font-size: 1.125rem;
    line-height: var(--leading-copy);
  }
  .party-story-name {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 2rem;
    /* Keep the display-sized inline name from expanding the first line box. */
    line-height: 0;
  }
  .party-story p + p {
    margin-top: var(--spacing-panel);
  }
  .party-playback {
    position: absolute;
    z-index: 10;
    top: var(--spacing-card);
    right: var(--spacing-card);
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid
      color-mix(in srgb, var(--color-ink) calc(96 / 255 * 100%), transparent);
    border-radius: 99px;
    background: color-mix(
      in srgb,
      var(--color-surface) calc(217 / 255 * 100%),
      transparent
    );
    color: var(--color-ink);
    cursor: pointer;
  }
  .party-playback .play-icon,
  .party-playback[data-paused="true"] .pause-icon {
    display: none;
  }
  .party-playback[data-paused="true"] .play-icon {
    display: block;
  }
  .party-playback:focus-visible {
    outline: 2px solid var(--color-highlight);
    outline-offset: 3px;
  }
  @media (min-width: 768px) {
    .party-video {
      height: 520px;
      max-height: none;
    }
    .party-story-panel {
      width: 65%;
      margin: -120px 5% 0 auto;
    }
    .party-story {
      padding: 32px;
    }
    .party-story p {
      display: inline;
    }
  }
</style>

<script>
  function setupPartyVideo() {
    const video =
      document.querySelector<HTMLVideoElement>("[data-party-video]");
    if (!video) return;
    const button = document.querySelector<HTMLButtonElement>(
      "[data-party-playback]",
    );
    if (button) {
      const updateLabel = () => {
        const action = video.paused ? "Play" : "Pause";
        button.dataset.paused = String(video.paused);
        button.setAttribute("aria-label", `${action} party video`);
      };
      button.onclick = () => {
        if (video.paused) video.play().catch(() => {});
        else video.pause();
      };
      video.onplay = updateLabel;
      video.onpause = updateLabel;
      updateLabel();
    }
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      video.removeAttribute("autoplay");
      video.pause();
    } else if (video.paused) {
      // autoplay doesn't re-fire when ClientRouter swaps the page back in
      video.play().catch(() => {});
    }
  }
  setupPartyVideo();
  document.addEventListener("astro:page-load", setupPartyVideo);
</script>
