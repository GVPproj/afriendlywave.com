---
interface Props {
  name: string;
  imageUrl: string;
  feedKey: string; // e.g. "/afriendlywave/show-name/"
}
const { name, imageUrl, feedKey } = Astro.props;

// Fetch tags from Mixcloud API at build time
interface MixcloudTag {
  key: string;
  url: string;
  name: string;
}

let tags: MixcloudTag[] = [];
try {
  const response = await fetch(`https://api.mixcloud.com${feedKey}`);
  if (response.ok) {
    const data = await response.json();
    tags = data.tags || [];
  }
} catch (e) {
  // Silently fail - tags are optional
}
---

<button
  type="button"
  data-feed={feedKey}
  class="group show-card border-text/20 block cursor-pointer rounded-md border p-3 text-left md:max-w-96"
>
  <div class="relative aspect-square overflow-hidden rounded">
    <img
      src={imageUrl}
      alt={name}
      class="h-full w-full object-cover transition-opacity group-hover:opacity-80"
      loading="lazy"
      width="600"
      height="600"
    />
    <div
      class="bg-primary group-hover:bg-orange absolute bottom-4 left-4 flex h-12 w-12 items-center justify-center rounded-full transition-colors"
    >
      <svg
        class="text-text ml-0.5 h-7 w-7"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path d="M8 5v14l11-7z"></path>
      </svg>
    </div>
  </div>
  <p class="text-text mt-2 truncate text-lg">{name}</p>
  {
    tags.length > 0 && (
      <div class="mt-1 flex flex-wrap gap-1">
        {tags.slice(0, 3).map((tag) => (
          <span class="bg-text/10 text-text/70 rounded-full px-2 pt-1 text-xs">
            {tag.name}
          </span>
        ))}
      </div>
    )
  }
</button>
