---
interface Props {
  name: string;
  imageUrl: string;
  feedKey: string; // e.g. "/afriendlywave/show-name/"
}
const { name, imageUrl, feedKey } = Astro.props;

// Fetch tags from Mixcloud API at build time
interface MixcloudTag {
  key: string;
  url: string;
  name: string;
}

let tags: MixcloudTag[] = [];
try {
  const response = await fetch(`https://api.mixcloud.com${feedKey}`);
  if (response.ok) {
    const data = await response.json();
    tags = data.tags || [];
  }
} catch (e) {
  // Silently fail - tags are optional
}
---

<button
  type="button"
  data-feed={feedKey}
  class="group show-card block max-w-96 text-left cursor-pointer border border-text/20 rounded-md p-3"
>
  <div class="aspect-square overflow-hidden rounded relative">
    <img
      src={imageUrl}
      alt={name}
      class="w-full h-full object-cover transition-opacity group-hover:opacity-80"
      loading="lazy"
      width="600"
      height="600"
    />
    <div
      class="absolute bottom-4 left-4 w-12 h-12 bg-primary group-hover:bg-link transition-colors rounded-full flex items-center justify-center"
    >
      <svg
        class="w-7 h-7 text-text ml-0.5"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path d="M8 5v14l11-7z"></path>
      </svg>
    </div>
  </div>
  <p class="mt-2 text-text text-lg truncate">{name}</p>
  {
    tags.length > 0 && (
      <div class="mt-1 flex flex-wrap gap-1">
        {tags.slice(0, 3).map((tag) => (
          <span class="text-xs px-2 pt-1 rounded-full bg-text/10 text-text/70">
            {tag.name}
          </span>
        ))}
      </div>
    )
  }
</button>
