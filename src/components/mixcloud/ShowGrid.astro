---
import ShowCard from "./ShowCard.astro";

interface Props {
  username?: string;
  limit?: number;
  offset?: number;
}

const { username = "afriendlywave", limit = 32, offset = 0 } = Astro.props;

const response = await fetch(
  `https://api.mixcloud.com/${username}/cloudcasts/?limit=${limit + offset}`,
);
const data = await response.json();
const shows = (data.data || []).slice(offset);
---

<div
  class="mx-auto grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4"
>
  {
    shows.map((show: any) => (
      <ShowCard
        name={show.name}
        imageUrl={show.pictures.extra_large}
        feedKey={show.key}
      />
    ))
  }
</div>

<script>
  document.addEventListener("click", (e) => {
    const card = (e.target as Element)?.closest(".show-card");
    if (!card) return;
    const feed = card.getAttribute("data-feed");
    if (feed) {
      window.dispatchEvent(
        new CustomEvent("mixcloud:play", { detail: { feed } }),
      );
    }
  });
</script>
