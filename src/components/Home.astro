---
import { Image } from "astro:assets";
import summerSessions from "../assets/AFW_SummerSessions_Eventbrite.jpg";
import summerSessionsPortrait from "../assets/AFW_SummerSessions_Eventbrite_portrait.jpg";
import ShowGrid from "./mixcloud/ShowGrid.astro";
import ShowCard from "./mixcloud/ShowCard.astro";
import partyMp4 from "../assets/afw_web_assets/partyvids/web/afw-party-720.mp4";
import partyWebm from "../assets/afw_web_assets/partyvids/web/afw-party-1080.webm";
import partyPoster from "../assets/afw_web_assets/partyvids/web/afw-party-poster.jpg";
// import Schedule from "./schedules/Schedule.astro";
// import { march2026 } from "../data/march2026schedule";

// Fetch two newest shows for featured display
const response = await fetch(
  "https://api.mixcloud.com/afriendlywave/cloudcasts/?limit=3",
);
const data = await response.json();
const featuredShows = data.data ?? [];
---

<main class="mx-auto mt-16 mb-32 flex max-w-screen-2xl flex-col gap-24 px-6">
  <!-- <a -->
  <!--   target="_blank" -->
  <!--   rel="noopener noreferrer" -->
  <!--   href="https://www.eventbrite.ca/e/a-friendly-wave-summer-session-tickets-1992181387157" -->
  <!--   class="border-text/20 block overflow-hidden rounded-md border p-3" -->
  <!-- > -->
  <!--   <Image -->
  <!--     src={summerSessionsPortrait} -->
  <!--     alt="A Friendly Wave Summer Sessions" -->
  <!--     class="w-full rounded md:hidden" -->
  <!--   /> -->
  <!--   <Image -->
  <!--     src={summerSessions} -->
  <!--     alt="A Friendly Wave Summer Sessions" -->
  <!--     class="hidden w-full rounded md:block" -->
  <!--   /> -->
  <!-- </a> -->
  <div
    class="flex flex-col gap-6 md:flex-row md:items-stretch md:justify-start"
  >
    {
      featuredShows.map((show: any) => (
        <ShowCard
          name={show.name}
          imageUrl={show.pictures.extra_large}
          feedKey={show.key}
        />
      ))
    }
  </div>
  <section class="border-text/20 rounded-md border p-3">
    <div class="relative overflow-hidden rounded">
      <video
        class="h-[60vh] w-full object-cover"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={partyPoster.src}
        data-party-video
      >
        <source src={partyWebm} type="video/webm" />
        <source src={partyMp4} type="video/mp4" />
      </video>
      <div
        class="absolute inset-0 flex items-center justify-center md:justify-start"
      >
        <div
          class="bg-primary/80 m-10 max-w-2xl rounded-md p-5 backdrop-blur-lg md:m-12 md:p-10"
        >
          <p class="text-text text-lg">
            <span class="text-link-hover">A Friendly Wave</span> is a unique cultural
            experiment that celebrates Salt Spring Island's creative spirit while
            introducing new perspectives on how we experience music together. Whether
            you're an audiophile, a casual listener, or simply curious about mindful
            cultural experiences, the Salt Spring Listening Space offers something
            transformative.
          </p>
        </div>
      </div>
    </div>
  </section>
  <ShowGrid offset={3} />
</main>

<script>
  function setupPartyVideo() {
    const video =
      document.querySelector<HTMLVideoElement>("[data-party-video]");
    if (!video) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      video.removeAttribute("autoplay");
      video.pause();
    } else if (video.paused) {
      // autoplay doesn't re-fire when ClientRouter swaps the page back in
      video.play().catch(() => {});
    }
  }
  setupPartyVideo();
  document.addEventListener("astro:page-load", setupPartyVideo);
</script>
