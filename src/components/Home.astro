---
import ShowGrid from "./mixcloud/ShowGrid.astro";
import ShowCard from "./mixcloud/ShowCard.astro";
import PartyVideoSection from "./PartyVideoSection.astro";

const response = await fetch(
  "https://api.mixcloud.com/afriendlywave/cloudcasts/?limit=3",
);
const data = await response.json();
const featuredShows = data.data ?? [];
---

<main
  class="site-container mt-page-start mb-player-clearance gap-section flex flex-col"
>
  <div
    class="show-featured flex flex-col gap-9 md:flex-row md:items-stretch md:justify-start"
  >
    {
      featuredShows.map((show: any) => (
        <ShowCard
          name={show.name}
          imageUrl={show.pictures.extra_large}
          feedKey={show.key}
        />
      ))
    }
  </div>
  <PartyVideoSection />
  <ShowGrid offset={3} />
</main>
