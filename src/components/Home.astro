---
import { Image } from "astro:assets";
import ShowGrid from "./mixcloud/ShowGrid.astro";
import ShowCard from "./mixcloud/ShowCard.astro";
import TShirt from "./merch/TShirt.astro";
import febScheduleImage from "../assets/schedules/AFW_SundaySessions_FEB2026_SM_Launch2.jpg";

// Fetch newest show for featured display
const response = await fetch(
  "https://api.mixcloud.com/afriendlywave/cloudcasts/?limit=1",
);
const data = await response.json();
const newestShow = data.data?.[0];
---

<main class="mx-auto mt-16 mb-32 flex max-w-screen-2xl flex-col gap-16 px-6">
  <div
    class="flex flex-col gap-6 md:flex-row md:items-stretch md:justify-start"
  >
    {
      newestShow && (
        <ShowCard
          name={newestShow.name}
          imageUrl={newestShow.pictures.extra_large}
          feedKey={newestShow.key}
        />
      )
    }
    <TShirt />
  </div>
  <!-- March schedule: stacked layout on mobile, table on large -->
  <section class="border-text/20 text-text rounded-md border p-6">
    <!-- Mobile layout -->
    <div class="flex flex-col gap-6 lg:hidden">
      <!-- FRIDAY -->
      <div class="border-text/30 border-b pb-6">
        <div class="mb-3 font-bold">FRI MARCH 6</div>
        <div class="mb-1 font-bold">COMMUNITY CURATION</div>
        <div class="flex gap-3">
          <span class="shrink-0">5:30pm</span>
          <span>DJ Flip presents: My Jazz and R&B journey from age 0–7</span>
        </div>
      </div>
      <!-- SATURDAY -->
      <div class="border-text/30 border-b pb-6">
        <div class="mb-3 font-bold">SAT MARCH 7</div>
        <div class="mb-1 font-bold">CAFÉ MODE</div>
        <div class="flex gap-3">
          <span class="shrink-0">10:00am</span>
          <span>Bo Meets World</span>
        </div>
        <div class="mb-4 flex gap-3">
          <span class="shrink-0">11:30am</span>
          <span>Connie Kuhns</span>
        </div>
        <div class="mb-1 font-bold">COMMUNITY CURATION</div>
        <div class="mb-4 flex gap-3">
          <span class="shrink-0">4:00pm</span>
          <span>Jamie Wollen presents: Music that takes you somewhere, with a number of stops being in Africa</span>
        </div>
        <div class="mb-1">
          <span class="font-bold">DARK MODE</span>
          <span class="ml-2 text-sm">* $20 advance/door</span>
        </div>
        <div class="flex gap-3">
          <span class="shrink-0">*7:00pm–late</span>
          <span>DJ D.DEE w/ Graham Van Pelt</span>
        </div>
      </div>
      <!-- SUNDAY -->
      <div>
        <div class="mb-3 font-bold">SUN MARCH 8</div>
        <div class="mb-1 font-bold">CAFÉ MODE</div>
        <div class="flex gap-3">
          <span class="shrink-0">10:00am</span>
          <span>Jeff Stefani</span>
        </div>
        <div class="mb-4 flex gap-3">
          <span class="shrink-0">11:30am</span>
          <span>Leo Chan</span>
        </div>
        <div class="mb-1">
          <span class="font-bold">DEEP LISTENING</span>
          <span class="ml-2 text-sm">* no entry after 3pm</span>
        </div>
        <div class="flex gap-3">
          <span class="shrink-0">*Doors: 2:30pm</span>
          <span>Robert Kraft presents: "Light as a Feather" Chick Corea and Return to Forever</span>
        </div>
      </div>
    </div>
    <table class="text-text hidden w-full table-fixed border-collapse lg:table">
      <colgroup>
        <col class="w-[10%]" />
        <col class="w-[25%]" />
        <col class="w-[12%]" />
        <col />
      </colgroup>
      <!-- FRIDAY -->
      <tbody>
        <tr class="border-text/30 border-b align-top">
          <td class="py-5 pr-6 font-bold" rowspan="1">
            FRI<br />MARCH<br />6
          </td>
          <td class="py-5 pr-6 font-bold">COMMUNITY CURATION</td>
          <td class="py-5 pr-6 text-right">5:30pm</td>
          <td class="py-5">
            DJ Flip presents:<br />My Jazz and R&B journey<br />from age 0–7
          </td>
        </tr>
      </tbody>
      <!-- SATURDAY -->
      <tbody>
        <tr class="border-text/30 align-top">
          <td class="pt-5 pr-6 font-bold" rowspan="3">
            SAT<br />MARCH<br />7
          </td>
          <td class="pt-5 pr-6 font-bold">CAFÉ MODE</td>
          <td class="pt-5 pr-6 text-right">
            10:00am<br />11:30am
          </td>
          <td class="pt-5">
            Bo Meets World<br />Connie Kuhns
          </td>
        </tr>
        <tr class="align-top">
          <td class="pt-6 pr-6 font-bold">COMMUNITY CURATION</td>
          <td class="pt-6 pr-6 text-right">4:00pm</td>
          <td class="pt-6">
            Jamie Wollen presents:<br />Music that takes you<br />somewhere,
            with a number<br />of stops being in Africa
          </td>
        </tr>
        <tr class="border-text/30 border-b align-top">
          <td class="pt-6 pr-6 pb-5">
            <span class="font-bold">DARK MODE</span><br />
            <span class="text-sm">* $20 advance/door</span>
          </td>
          <td class="pt-6 pr-6 pb-5 text-right">
            *7:00pm<br />–late
          </td>
          <td class="pt-6 pb-5">
            DJ D.DEE w/<br />Graham Van Pelt
          </td>
        </tr>
      </tbody>
      <!-- SUNDAY -->
      <tbody>
        <tr class="border-text/30 border-t align-top">
          <td class="pt-5 pr-6 font-bold" rowspan="2">
            SUN<br />MARCH<br />8
          </td>
          <td class="pt-5 pr-6 font-bold">CAFÉ MODE</td>
          <td class="pt-5 pr-6 text-right">
            10:00am<br />11:30am
          </td>
          <td class="pt-5">
            Jeff Stefani<br />Leo Chan
          </td>
        </tr>
        <tr class="border-text/30 align-top">
          <td class="pt-6 pr-6 pb-5">
            <span class="font-bold">DEEP LISTENING</span><br />
            <span class="text-sm">* no entry after 3pm</span>
          </td>
          <td class="pt-6 pr-6 pb-5 text-right">
            *Doors:<br />2:30pm
          </td>
          <td class="pt-6 pb-5">
            Robert Kraft presents:<br />"Light as a Feather"<br />Chick Corea
            and Return<br />to Forever
          </td>
        </tr>
      </tbody>
    </table>
  </section>
  <section class="border-text/20 rounded-md border p-6">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-center">
      <h2
        class="text-text text-center text-2xl font-bold lg:w-1/2 lg:text-left"
      >
        Join us for coffee at our all-vinyl Sunday Sessions, all through
        February 2026 at <a
          href="https://www.cassettecafebar.com/"
          target="_blank"
          rel="noopener noreferrer">Cassette Cafe</a
        >!
      </h2>
      <Image
        src={febScheduleImage}
        alt="A Friendly Wave Sunday Sessions - February 2026 Schedule"
        class="w-full lg:w-1/2"
      />
    </div>
  </section>
  <p class="text-text">
    <span class="text-link-hover">A Friendly Wave</span> is a unique cultural experiment
    that celebrates Salt Spring Island's creative spirit while introducing new perspectives
    on how we experience music together. Whether you're an audiophile, a casual listener,
    or simply curious about mindful cultural experiences, the Salt Spring Listening
    Space offers something transformative.
  </p>
  <ShowGrid offset={1} />
</main>
