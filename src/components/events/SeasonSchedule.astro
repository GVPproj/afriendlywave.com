---
import { Image } from "astro:assets";
import schedule from "../../assets/events/AFW-01_2026-10_Post_ScheduleFIXED.png";
---

<section
  aria-labelledby="season4-schedule-title"
  class="grid h-full items-center"
>
  <Image
    src={schedule}
    alt="A Friendly Wave Season 4 schedule poster: lime background with berry headings and navy lettering. Full programme transcribed below."
    widths={[480, 768, 1200, 1600, 2000]}
    sizes="auto, (min-width: 1536px) 670px, (min-width: 1024px) 44vw, 90vw"
    loading="lazy"
    class="block h-auto w-full"
  />
  <div class="sr-only">
    <h2 id="season4-schedule-title">A Friendly Wave / Season 4</h2>
    <p>Cassette Café, Salt Spring Island. October 24–25, 2026.</p>
    <h3>Saturday, October 24</h3>
    <ul>
      <li>10am–2pm: Café Mode — local AFW Selectors.</li>
      <li>10am–2pm: Record Shop &amp; Swap — local and visiting collectors.</li>
      <li>4pm–5pm: Community Curation — Michelle Footz.</li>
      <li>8pm–late: Dark Mode — Christa Belle and DJ Dampfnudel.</li>
    </ul>
    <h3>Sunday, October 25</h3>
    <ul>
      <li>
        10am–1pm: Café Mode — DJ Gus and Zelk (Conor McGillivray, Rowen Manz,
        Oscar Scaia).
      </li>
      <li>2pm–4pm: Youth DJ Workshop — Graham Van Pelt.</li>
    </ul>
  </div>
</section>
