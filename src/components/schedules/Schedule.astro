---
import dude from "../../assets/dude/AFW_Dude_5.0_F0F0EB.png";
import type { ScheduleData } from "../../data/scheduleTypes";
import Banner from "../elements/Banner.astro";

interface Props {
  schedule: ScheduleData;
}

const { schedule } = Astro.props;
---

<section class="border-text/20 text-text rounded-md border p-6">
  <div class="mx-auto w-4/5 md:w-1/2">
    <Banner />
  </div>
  <h1 class="mx-auto my-6 text-center text-2xl sm:text-4xl">
    {schedule.month} @ <a
      href="https://www.cassettecafebar.com/"
      target="_blank"
      rel="noopener noreferrer">Cassette Cafe</a
    >
  </h1>
  <img src={dude.src} alt="" class="mx-auto mb-6 w-1/3 md:w-1/8" />
  <!-- Mobile layout -->
  <div class="flex flex-col gap-6 lg:hidden">
    {
      schedule.days.map((day, dayIdx) => (
        <div
          class={
            dayIdx < schedule.days.length - 1
              ? "border-text/30 border-b pb-6"
              : ""
          }
        >
          <div class="mb-3 font-bold">{day.label}</div>
          {day.sections.map((section, secIdx) => {
            const content = (
              <>
                <div class="mb-1">
                  <span class="font-bold">{section.mode}</span>
                  {section.note && (
                    <span class="ml-2 text-sm">{section.note}</span>
                  )}
                </div>
                {section.slots.map((slot, slotIdx) => (
                  <div
                    class={`flex gap-3${slotIdx === section.slots.length - 1 && secIdx < day.sections.length - 1 ? " mb-4" : ""}`}
                  >
                    <span class="shrink-0">{slot.time}</span>
                    <span>{slot.description}</span>
                  </div>
                ))}
              </>
            );
            return section.link ? (
              <a
                href={section.link}
                target="_blank"
                rel="noopener noreferrer"
                class="text-orange hover:text-yellow block"
                data-ticket-link
              >
                {content}
              </a>
            ) : (
              <div>{content}</div>
            );
          })}
        </div>
      ))
    }
  </div>
  <!-- Desktop table -->
  <table class="text-text mx-auto hidden max-w-7xl border-collapse lg:table">
    {
      schedule.days.map((day, dayIdx) => (
        <tbody>
          {day.sections.map((section, secIdx) => {
            const isFirstSection = secIdx === 0;
            const isLastSection = secIdx === day.sections.length - 1;
            const isLastDay = dayIdx === schedule.days.length - 1;
            const borderClass =
              isLastSection && !isLastDay ? "border-text/30 border-b" : "";
            const topBorderClass =
              isFirstSection && dayIdx > 0 ? "border-text/30 border-t" : "";

            const ptClass = isFirstSection ? "pt-5" : "pt-6";
            const pbClass = isLastSection && !isLastDay ? "pb-5" : "";

            const modeClasses = `px-20 ${ptClass} ${pbClass} ${section.note ? "" : "font-bold"}`;
            const timeClasses = `px-20 ${ptClass} ${pbClass} text-right`;
            const descClasses = `${ptClass} ${pbClass}`;

            const wrap = (content: astroHTML.JSX.Element) =>
              section.link ? (
                <a
                  href={section.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-orange group-hover:text-yellow"
                >
                  {content}
                </a>
              ) : (
                content
              );

            return (
              <tr
                class={`align-top ${borderClass} ${topBorderClass} ${section.link ? "group cursor-pointer" : ""}`}
                {...(section.link ? { "data-ticket-link": "" } : {})}
              >
                {isFirstSection && (
                  <td
                    class="pt-5 pr-20 font-bold"
                    rowspan={day.sections.length}
                  >
                    {day.shortLabel.day}
                    <br />
                    {day.shortLabel.month}
                    <br />
                    {day.shortLabel.date}
                  </td>
                )}
                <td class={modeClasses}>
                  {wrap(
                    section.note ? (
                      <>
                        <span class="font-bold">{section.mode}</span>
                        <br />
                        <span class="text-sm">{section.note}</span>
                      </>
                    ) : (
                      section.mode
                    ),
                  )}
                </td>
                <td class={timeClasses}>
                  {wrap(
                    section.slots.map((slot, i) => (
                      <>
                        {i > 0 && <br />}
                        {slot.time}
                      </>
                    )),
                  )}
                </td>
                <td class={descClasses}>
                  {wrap(
                    section.slots.map((slot, i) => (
                      <>
                        {i > 0 && <br />}
                        {slot.description}
                      </>
                    )),
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      ))
    }
  </table>
  <div
    id="ticket-tooltip"
    class="bg-text pointer-events-none fixed z-50 rounded px-2 py-1 text-lg text-primary opacity-0 transition-opacity duration-200"
  >
    Get Tickets
  </div>
</section>

<script>
  const tip = document.getElementById("ticket-tooltip")!;
  document.querySelectorAll("[data-ticket-link]").forEach((el) => {
    el.addEventListener("mousemove", (e: Event) => {
      const { clientX, clientY } = e as MouseEvent;
      tip.style.left = clientX + "px";
      tip.style.top = clientY - tip.offsetHeight + "px";
      tip.classList.remove("opacity-0");
      tip.classList.add("opacity-100");
    });
    el.addEventListener("mouseleave", () => {
      tip.classList.remove("opacity-100");
      tip.classList.add("opacity-0");
    });
    el.addEventListener("click", (e: Event) => {
      const target = e.target as HTMLElement;
      if (target.closest("a")) return;
      const link = (e.currentTarget as HTMLElement).querySelector("a");
      if (link) window.open(link.href, "_blank", "noopener,noreferrer");
    });
  });
</script>
