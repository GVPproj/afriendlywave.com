---
import { ClientRouter } from "astro:transitions";
import Header from "../components/elements/Header.astro";
import MixcloudPlayer from "../components/mixcloud/MixcloudPlayer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "A Friendly Wave",
  description = "A unique cultural experiment celebrating Salt Spring Island's creative spirit. Experience music together at our Salt Spring listening space.",
} = Astro.props;

// Link-preview image (WhatsApp, iMessage, etc.): the dancers on navy, no event text.
const ogImage = "https://afriendlywave.com/og/afw-preview.jpg";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <!-- Nav-critical face: start the fetch before the stylesheet is parsed.
         crossorigin is required for the preload to match the font request. -->
    <link
      rel="preload"
      href="/fonts/iosevka-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:site_name" content="A Friendly Wave" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="bg-surface text-ink text-body leading-copy font-sans">
    <Header />
    <slot />
    <MixcloudPlayer />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
  }
</style>
