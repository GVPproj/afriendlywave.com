---
import Header from "../components/elements/Header.astro";
import MixcloudPlayer from "../components/elements/MixcloudPlayer.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>A Friendly Wave</title>
  </head>
  <body class="bg-primary text-text font-sans text-xl">
    <Header />
    <slot />
    <MixcloudPlayer />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
  }
</style>
