---
import { ClientRouter } from "astro:transitions";
import Header from "../components/elements/Header.astro";
import MixcloudPlayer from "../components/mixcloud/MixcloudPlayer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "A Friendly Wave" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
    <meta
      name="description"
      content="A unique cultural experiment celebrating Salt Spring Island's creative spirit. Experience music together at our Salt Spring listening space."
    />

    <!-- Open Graph -->
    <meta property="og:title" content="A Friendly Wave" />
    <meta
      property="og:description"
      content="A unique cultural experiment celebrating Salt Spring Island's creative spirit. Experience music together at our Salt Spring listening space."
    />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content="https://res.cloudinary.com/dngvurpdw/image/upload/v1747231904/AFW_Illustration_12_sci8jw.jpg"
    />
    <meta
      property="og:image:secure_url"
      content="https://res.cloudinary.com/dngvurpdw/image/upload/v1747231904/AFW_Illustration_12_sci8jw.jpg"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="A Friendly Wave" />
    <meta name="twitter:description" content="A Friendly Wave" />
    <meta
      name="twitter:image"
      content="https://res.cloudinary.com/dngvurpdw/image/upload/v1747231904/AFW_Illustration_12_sci8jw.jpg"
    />
  </head>
  <body class="bg-primary text-text font-sans text-xl">
    <Header />
    <slot />
    <MixcloudPlayer />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
  }
</style>
